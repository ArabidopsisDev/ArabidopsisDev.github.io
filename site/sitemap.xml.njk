---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absoluteUrl }}</loc><changefreq>monthly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ '/history.html' | absoluteUrl }}</loc><changefreq>yearly</changefreq><priority>0.3</priority></url>
  {% for item in collections.all %}{% if item.url and item.data.eleventyExcludeFromCollections != true %}
  <url><loc>{{ item.url | absoluteUrl }}</loc>{% if item.date %}<lastmod>{{ item.date | rfc3339 }}</lastmod>{% endif %}</url>
  {% endif %}{% endfor %}
</urlset>
